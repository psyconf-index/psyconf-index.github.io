{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://psyconf-index.github.io/schemas/editions.schema.json",
  "title": "PsyConf Index event editions",
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["edition_id", "series_id", "edition_label", "short_title", "short_description", "start_date", "end_date", "cfp_deadline", "notification_date", "early_bird_deadline", "format", "city", "country_code", "languages", "currency", "fees", "travel_grants_available", "sponsors_note", "proceedings_published", "edition_url"],
    "properties": {
      "edition_id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$", "minLength": 2, "maxLength": 100},
      "series_id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
      "edition_label": {"type": "string", "minLength": 1, "maxLength": 80},
      "short_title": {"type": "string", "minLength": 1, "maxLength": 200},
      "short_description": {"type": "string", "maxLength": 240},
      "start_date": {"type": "string", "format": "date"},
      "end_date": {"type": "string", "format": "date"},
      "cfp_deadline": {"type": ["string", "null"], "format": "date"},
      "notification_date": {"type": ["string", "null"], "format": "date"},
      "early_bird_deadline": {"type": ["string", "null"], "format": "date"},
      "format": {"enum": ["in_person", "hybrid", "online"]},
      "city": {"type": "string", "minLength": 1, "maxLength": 100},
      "country_code": {"type": "string", "pattern": "^[A-Z]{2}$", "description": "ISO 3166-1 alpha-2 country code."},
      "languages": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z]{2}$", "description": "ISO 639-1 language code."}},
      "currency": {"type": "string", "pattern": "^[A-Z]{3}$", "description": "ISO 4217 currency code."},
      "fees": {
        "type": "object",
        "additionalProperties": false,
        "required": ["student_early", "member_early", "non_member_early", "listener_only"],
        "properties": {
          "student_early": {"type": ["number", "null"], "minimum": 0},
          "member_early": {"type": ["number", "null"], "minimum": 0},
          "non_member_early": {"type": ["number", "null"], "minimum": 0},
          "listener_only": {"type": ["number", "null"], "minimum": 0}
        }
      },
      "travel_grants_available": {"type": "boolean"},
      "sponsors_note": {"type": "string", "maxLength": 1000},
      "proceedings_published": {"type": "boolean"},
      "edition_url": {"type": "string", "format": "uri", "pattern": "^https://"}
    }
  }
}
